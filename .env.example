# ==============================================================================
# Exam Paper OCR Extractor - Environment Configuration
# ==============================================================================

# Server Network & Debug Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Paths & Directories
MODEL_DIR=models
UPLOAD_DIR=uploads
DB_PATH=jobs.db

# Processing Constraints & Worker Limits
MAX_UPLOAD_MB=25
MAX_FILES_PER_JOB=100
MAX_QUEUED_JOBS=10
WORKERS=2
ORT_THREADS=4
RETENTION_DAYS=7

# Feature Toggles
ENABLE_LEGACY=false
ENABLE_UI=false
ENABLE_PAGE_LOCALISER=false

# Security & CORS (comma-separated list of allowed origins)
CORS_ORIGINS=*

# Legacy YOLO / PaddleOCR Settings (only active when ENABLE_LEGACY=true)
YOLO_MODEL_PATH=models/best.pt
YOLO_CONF_THRESH=0.30
YOLO_IMGSZ=1280
PADDING_RATIO=0.05
OCR_CONF_THRESH=0.60
OCR_LANG=en
